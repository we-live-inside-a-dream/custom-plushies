# Copy to .env and fill in. Used by docker-compose.yml.

# A long random string (at least 32 characters) that signs login tokens.
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

POSTGRES_PASSWORD=change-me

# First admin account, created on first start if no admin exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# Load the demo catalogue (8 plushies, 3 demo customers) into an empty database.
SEED_DEMO_DATA=true

# Chit Chats. Sandbox: https://staging.chitchats.com/api/v1   Live: https://chitchats.com/api/v1
# Client id and token come from Chit Chats > Settings > Developer > API Access Tokens.
CHITCHATS_BASE_URL=https://staging.chitchats.com/api/v1
CHITCHATS_CLIENT_ID=
CHITCHATS_ACCESS_TOKEN=
# HS tariff code used for products that don't set their own. Confirm with your customs broker.
CHITCHATS_DEFAULT_HS_TARIFF_CODE=

# The built-in gateway takes no real money. It must be allowed explicitly outside Development.
PAYMENTS_ALLOW_TEST_GATEWAY=true
